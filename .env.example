# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# cIDR stablecoin (issued on testnet) + treasury
CIDR_ASSET_CODE=cIDR
CIDR_ISSUER_PUBLIC=
CIDR_ISSUER_SECRET=
TREASURY_PUBLIC=
TREASURY_SECRET=

# Holds the cIDR float paid out to users on the crypto on-ramps (USDC + XLM). The treasury
# takes the incoming crypto as reserve; this account issues the matching cIDR.
DISTRIBUTOR_PUBLIC=
DISTRIBUTOR_SECRET=

# USDC on Stellar testnet (Circle test issuer)
USDC_ASSET_CODE=USDC
USDC_ISSUER=

# Circle's real USDC on Stellar testnet — for the connect-wallet (Freighter) crypto on-ramp
CIRCLE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Deployed escrow contract
ESCROW_CONTRACT_ID=

# --- Twilio WhatsApp Sandbox (free) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Stripe (USD on-ramp, test mode) ---
STRIPE_SECRET_KEY=sk_test_...

# --- Xendit (QRIS merchant settlement / IDR disbursement, test mode) ---
XENDIT_SECRET_KEY=xnd_development_...

# --- App ---
# Postgres (Neon free tier) — persists across Render redeploys / cold starts
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
PORT=3001
WEB_WALLET_URL=http://localhost:3000

# Signs session/magic-link tokens. Generate: openssl rand -base64 48
SESSION_SECRET=

# This service's own public URL — required to verify Twilio's webhook signature
# (behind a proxy the request URL is not the URL Twilio signed).
PUBLIC_URL=http://localhost:3001

# Testnet demo faucet (POST /fund). Leave unset in any real deployment.
ALLOW_DEMO_FUND=true

# Local dev only: print the WhatsApp OTP to the server console. Never set in production.
LOG_OTP=true
